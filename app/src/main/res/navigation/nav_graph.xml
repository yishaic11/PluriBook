<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/login_fragment">

    <action
        android:id="@+id/action_global_login_fragment"
        app:destination="@id/login_fragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/login_fragment"
        android:name="com.example.pluribook.ui.auth.LoginFragment"
        android:label="@string/nav_login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signup_fragment" />

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/home_fragment"
            app:popUpTo="@id/login_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signup_fragment"
        android:name="com.example.pluribook.ui.auth.SignUpFragment"
        android:label="@string/nav_signup"
        tools:layout="@layout/fragment_signup">

        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/home_fragment"
            app:popUpTo="@id/login_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/home_fragment"
        android:name="com.example.pluribook.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_fragment_to_post_fragment"
            app:destination="@id/post_fragment" />

        <action
            android:id="@+id/action_home_fragment_to_profile_fragment"
            app:destination="@id/profile_fragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_home_fragment_to_create_post_fragment"
            app:destination="@id/create_post_fragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/create_post_fragment"
        android:name="com.example.pluribook.ui.post.create.CreatePostFragment"
        android:label="@string/nav_create_post"
        tools:layout="@layout/fragment_create_post">

        <action
            android:id="@+id/action_create_post_to_home"
            app:destination="@id/home_fragment"
            app:popUpTo="@id/home_fragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_create_post_fragment_to_profile_fragment"
            app:destination="@id/profile_fragment"
            app:launchSingleTop="true" />
    </fragment>

    <fragment
        android:id="@+id/profile_fragment"
        android:name="com.example.pluribook.ui.profile.ProfileFragment"
        android:label="@string/nav_user_profile"
        tools:layout="@layout/fragment_profile">

        <argument
            android:name="targetUserId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <action
            android:id="@+id/action_profile_fragment_to_home_fragment"
            app:destination="@id/home_fragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_profile_fragment_to_create_post_fragment"
            app:destination="@id/create_post_fragment"
            app:launchSingleTop="true" />

        <action
            android:id="@+id/action_profileFragment_to_postDetailFragment"
            app:destination="@id/post_fragment" />

        <action
            android:id="@+id/action_profile_fragment_to_edit_profile_fragment"
            app:destination="@id/edit_profile_fragment" />
    </fragment>

    <fragment
        android:id="@+id/edit_profile_fragment"
        android:name="com.example.pluribook.ui.profile.edit.EditProfileFragment"
        android:label="@string/edit_profile_header"
        tools:layout="@layout/fragment_edit_profile">

        <action
            android:id="@+id/action_edit_profile_fragment_to_profile_fragment"
            app:destination="@id/profile_fragment"
            app:popUpTo="@id/profile_fragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/post_fragment"
        android:name="com.example.pluribook.ui.post.PostFragment"
        android:label="@string/nav_post"
        tools:layout="@layout/fragment_post">

        <argument
            android:name="postId"
            app:argType="string" />

        <action
            android:id="@+id/action_post_fragment_to_comment_fragment"
            app:destination="@id/comment_fragment" />

        <action
            android:id="@+id/action_post_fragment_to_edit_post_fragment"
            app:destination="@id/edit_post_fragment" />

        <action
            android:id="@+id/action_post_fragment_to_profile_fragment"
            app:destination="@id/profile_fragment" />

        <action
            android:id="@+id/action_post_fragment_to_other_profile_fragment"
            app:destination="@id/other_profile_fragment" />

        <action
            android:id="@+id/action_post_fragment_to_home_fragment"
            app:destination="@id/home_fragment" />
    </fragment>

    <fragment
        android:id="@+id/comment_fragment"
        android:name="com.example.pluribook.ui.comment.CommentFragment"
        android:label="Comments"
        tools:layout="@layout/fragment_comment">

        <argument
            android:name="postId"
            app:argType="string" />

        <action
            android:id="@+id/action_comment_fragment_to_post_fragment"
            app:destination="@id/post_fragment" />
    </fragment>

    <fragment
        android:id="@+id/edit_post_fragment"
        android:name="com.example.pluribook.ui.post.edit.EditPostFragment"
        android:label="@string/edit_post_header"
        tools:layout="@layout/fragment_edit_post">

        <argument
            android:name="postId"
            app:argType="string" />

        <action
            android:id="@+id/action_edit_post_fragment_to_post_fragment"
            app:destination="@id/post_fragment" />
    </fragment>

    <fragment
        android:id="@+id/other_profile_fragment"
        android:name="com.example.pluribook.ui.profile.OtherProfileFragment"
        android:label="User Profile"
        tools:layout="@layout/fragment_profile">

        <argument
            android:name="targetUserId"
            app:argType="string" />

        <action
            android:id="@+id/action_otherProfile_to_postDetail"
            app:destination="@id/post_fragment" />
    </fragment>
</navigation>